#!/bin/sh
set -eu

if [ "${SKIP_PRE_COMMIT_CHECKS:-}" = "1" ] || [ "${SKIP_PRE_COMMIT_TESTS:-}" = "1" ]; then
  echo "pre-commit: skipping checks"
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "pre-commit: running mobile unit tests"
echo "pre-commit: bypass with 'git commit --no-verify' when you intentionally need to skip local checks"

pnpm test:mobile

echo "pre-commit: running Maestro testID + route coverage gate"
echo "pre-commit: this mirrors the CI gate that blocks OTA updates if either drops below 90%"

( cd apps/mobile && pnpm test:e2e:coverage )

#!/bin/sh
set -eu

if [ "${SKIP_PRE_PUSH_CHECKS:-}" = "1" ] || [ "${SKIP_PRE_PUSH_TESTS:-}" = "1" ]; then
  echo "pre-push: skipping checks"
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "pre-push: running mobile unit tests with coverage"
echo "pre-push: bypass with 'git push --no-verify' when you intentionally need to skip local checks"

# Mirrors the `Mobile Tests` GitHub workflow which runs `pnpm test:coverage`
# and enforces the v8 thresholds in apps/mobile/vitest.config.ts. Running
# the same command locally means CI failures from drifting coverage are
# caught before they block the OTA push.
pnpm --filter mobile test:coverage

echo "pre-push: running Maestro testID + route coverage gate"
echo "pre-push: this mirrors the CI gate that blocks OTA updates if either drops below 90%"

( cd apps/mobile && pnpm test:e2e:coverage )

echo "pre-push: running mobile OTA export check"

pnpm build:mobile:update

# Local edge-runtime env, auto-loaded by `supabase start`.
#
# This file is *committed on purpose*. It only affects the local Supabase
# stack started by `npx supabase start`. Production deploys via
# `supabase functions deploy` do NOT read this file — secrets in the
# hosted project are managed with `supabase secrets set ...`.
#
# Defaults below are chosen so that a fresh clone + `npx supabase start`
# is immediately usable for E2E and manual development without spending
# tokens or requiring API keys.

# Serve canned LLM / transcription / summarize fixtures instead of calling
# real providers. To run against the real LLM locally (e.g. when capturing
# new fixtures), unset this:
#     USE_FIXTURES= npx supabase start
# or
#     USE_FIXTURES=false npx supabase functions serve generate-report
USE_FIXTURES=true

# Simulated provider latency for fixture mode. Defaults to 0ms for fast
# E2E and dev iteration. Set to e.g. 5000 if you want to see loading
# states during manual testing.
FIXTURES_DELAY_MS=0

# Provider name still flows through to the response metadata even in
# fixture mode (no real call is made).
AI_PROVIDER=kimi

# Local development environment template for @harpa/api.
# Copy to `.env` and fill in. Production secrets are managed by Doppler.

NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# Postgres — point at the Supabase local stack or a Testcontainer.
# Format: postgres://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Used to verify Supabase JWTs (JWKS fetched from <SUPABASE_URL>/.well-known/jwks.json).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of allowed origins for browser clients (playground).
ALLOWED_ORIGINS=http://localhost:5173

# Test-only HS256 secret for the auth middleware bypass. Only honoured
# when NODE_ENV=test.
TEST_JWT_SECRET=dev-only-replace-me

# Optional.
SENTRY_DSN=

# Upstash Redis (optional). When BOTH are set, the rate-limit middleware
# uses Redis instead of in-memory state — required once the Fly app
# runs on >1 machine. Get these from the Upstash console or via the
# management API (see packages/api/README.md → Rate limiting).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

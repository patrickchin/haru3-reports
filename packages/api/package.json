{
  "name": "@harpa/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate:openapi": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "@hono/zod-openapi": "^0.19.0",
    "@hono/node-server": "^1.13.0",
    "drizzle-orm": "^0.44.0",
    "postgres": "^3.4.0",
    "jose": "^6.0.0",
    "zod": "^3.24.0",
    "@harpa/report-core": "workspace:*",
    "@harpa/api-contract": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "tsup": "^8.4.0",
    "vitest": "^4.1.4",
    "typescript": "~5.9.2",
    "drizzle-kit": "^0.31.0",
    "@types/node": "^22.0.0"
  }
}

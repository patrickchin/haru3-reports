# EAS Build upload filter.
# Keeps apps/mobile-v3/{ios,android} (prebuilt native dirs) even though
# they are gitignored, since EAS needs them in the tarball.

# dependencies
node_modules/

# Personal AI tooling
.opencode/
skills/
opencode.json
.pnp
.pnp.js

# build outputs
dist/
build/
.next/
out/
web-build/
.preview-report.html

# Expo
.expo/
expo-env.d.ts

# (intentionally NOT ignoring apps/mobile-v3/ios/ or apps/mobile-v3/android/)
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Turbo
.turbo/

# Supabase local
.branches/
.temp/

# debug logs
npm-debug.*
yarn-debug.*
yarn-error.*

# editor
.vscode/

# macOS
.DS_Store
*.pem

# env files
.env
.env*
!.env.example
!supabase/.env.fixtures
.env.local
.env*.local
*.bak

# test coverage
coverage/

# typescript
*.tsbuildinfo
.vercel

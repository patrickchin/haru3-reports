{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development-v3",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview-v3",
      "environment": "preview"
    },
    "preview-sim": {
      "extends": "preview",
      "ios": { "simulator": true }
    },
    "production": {
      "channel": "production-v3",
      "autoIncrement": true,
      "environment": "production"
    }
  },
  "submit": { "production": {} }
}

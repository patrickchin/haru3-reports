{
  "expo": {
    "name": "Harpa Pro",
    "slug": "harpa-pro-v3",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "harpa-v3",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f47316"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.harpa.pro.v3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow Harpa Pro to use the camera to capture site photos.",
        "NSMicrophoneUsageDescription": "Allow Harpa Pro to use the microphone for voice notes.",
        "NSPhotoLibraryUsageDescription": "Allow Harpa Pro to access your photos to attach images to reports."
      }
    },
    "runtimeVersion": "1.0.0",
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#f47316",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.harpa.pro.v3",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-build-properties", { "android": { "largeHeap": true } }],
      ["expo-file-system", { "supportsOpeningDocumentsInPlace": true, "enableFileSharing": true }],
      ["expo-audio", { "microphonePermission": "Allow $(PRODUCT_NAME) to use the microphone for voice notes." }],
      ["expo-document-picker", { "iCloudContainerEnvironment": "Production" }],
      ["expo-image-picker", {
        "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to attach images to reports.",
        "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to capture site photos."
      }],
      ["expo-camera", { "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to capture site photos.", "recordAudioAndroid": false }]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "placeholder-will-be-set-later"
      }
    }
  }
}

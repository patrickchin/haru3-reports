    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.99.2",
    "@tanstack/react-query": "^5.90.21",
    "expo": "~55.0.9",
    "expo-audio": "~55.0.14",
    "expo-av": "^16.0.8",
    "expo-build-properties": "^55.0.13",
    "expo-camera": "^55.0.18",
    "expo-clipboard": "^55.0.13",
    "expo-constants": "~55.0.9",
    "expo-crypto": "~55.0.14",
    "expo-dev-client": "~55.0.19",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "^55.0.16",
    "expo-font": "~55.0.4",
    "expo-image": "^55.0.9",
    "expo-image-manipulator": "~55.0.15",
    "expo-image-picker": "~55.0.19",
    "expo-linking": "~55.0.9",
    "expo-print": "^55.0.13",
    "expo-router": "~55.0.8",
    "expo-sharing": "^55.0.18",
    "expo-status-bar": "~55.0.4",
    "expo-updates": "~55.0.16",
    "lucide-react-native": "^0.577.0",
    "react": "19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "0.83.4",

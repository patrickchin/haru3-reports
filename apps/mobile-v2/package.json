{
  "name": "mobile-v2",
  "version": "2.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:mock": "EXPO_PUBLIC_E2E_MOCK_VOICE_NOTE=true EXPO_PUBLIC_ENABLE_DEV_PHONE_AUTH=true expo run:ios",
    "ios:mock:release": "EXPO_PUBLIC_E2E_MOCK_VOICE_NOTE=true EXPO_PUBLIC_ENABLE_DEV_PHONE_AUTH=true expo run:ios --configuration Release",
    "android:mock": "EXPO_PUBLIC_E2E_MOCK_VOICE_NOTE=true EXPO_PUBLIC_ENABLE_DEV_PHONE_AUTH=true expo run:android",
    "web": "expo start --web",
    "build:update": "expo export --output-dir /tmp/haru3-mobile-v2-export-check --source-maps --dump-assetmap --platform ios --platform android --clear",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "maestro test .maestro/",
    "test:e2e:coverage": "node .maestro/scripts/coverage.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@harpa/report-core": "workspace:*",
    "@hookform/resolvers": "^3.9.0",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.99.2",
    "@tanstack/react-query": "^5.90.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "expo": "~55.0.9",
    "expo-audio": "~55.0.14",
    "expo-build-properties": "^55.0.13",
    "expo-camera": "^55.0.18",
    "expo-clipboard": "^55.0.13",
    "expo-constants": "~55.0.9",
    "expo-crypto": "~55.0.14",
    "expo-dev-client": "~55.0.19",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "^55.0.16",
    "expo-font": "~55.0.4",
    "expo-image": "^55.0.9",
    "expo-image-manipulator": "~55.0.15",
    "expo-image-picker": "~55.0.19",
    "expo-linking": "~55.0.9",
    "expo-print": "^55.0.13",
    "expo-router": "~55.0.8",
    "expo-sharing": "^55.0.18",
    "expo-status-bar": "~55.0.4",
    "expo-updates": "~55.0.16",
    "lucide-react-native": "^0.577.0",
    "nativewind": "^4.2.3",
    "react": "19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.0",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "@vitest/coverage-v8": "^4.1.4",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import-x": "^4.3.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.4"
  },
  "private": true
}
